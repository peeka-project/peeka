# Peeka Python 3.14 测试镜像 (PEP 768)
# 构建: docker build -f docker/Dockerfile.py314 -t peeka-py314 .
# 运行: docker run -it --cap-add=SYS_PTRACE peeka-py314

FROM python:3.14-rc-slim

LABEL maintainer="peeka"
LABEL description="Peeka testing with Python 3.14 (PEP 768)"

RUN apt-get update && apt-get install -y --no-install-recommends \
    procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml .
COPY peeka/ ./peeka/
COPY examples/ ./examples/

RUN pip install --no-cache-dir -e ".[tui]"

RUN cat > /app/test-py314.sh << 'EOF'
#!/bin/bash
set -e

echo "=========================================="
echo "  Peeka - Python 3.14 (PEP 768) 测试"
echo "=========================================="
echo ""
echo "Python 版本: $(python --version)"
echo ""

# 检查 sys.remote_exec 是否可用
python -c "
import sys
if hasattr(sys, 'remote_exec'):
    print('✓ sys.remote_exec 可用 (PEP 768)')
else:
    print('✗ sys.remote_exec 不可用')
"
echo ""

# 启动 demo 应用
echo "[1] 启动 demo 应用..."
python examples/demo.py --mode loop &
DEMO_PID=$!
sleep 2

echo ""
echo "Demo PID: $DEMO_PID"
echo ""
echo "=========================================="
echo "  PEP 768 测试命令"
echo "=========================================="
echo ""
echo "# 附加 (使用 sys.remote_exec，无需 GDB)"
echo "peeka-cli attach $DEMO_PID"
echo ""
echo "# 观测函数"
echo "peeka-cli attach $DEMO_PID"
echo "peeka-cli watch 'demo.Calculator.add' -n 5"
echo ""
echo "=========================================="
echo ""

exec bash
EOF
RUN chmod +x /app/test-py314.sh

CMD ["/app/test-py314.sh"]

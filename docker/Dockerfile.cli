# Peeka CLI 测试镜像
# 构建: docker build -f docker/Dockerfile.cli -t peeka-cli .
# 运行: docker run -it --cap-add=SYS_PTRACE peeka-cli

FROM python:3.12-slim

LABEL maintainer="peeka"
LABEL description="Peeka CLI testing environment"

RUN apt-get update && apt-get install -y --no-install-recommends \
    gdb \
    procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml .
COPY peeka/ ./peeka/
COPY examples/ ./examples/

RUN pip install --no-cache-dir -e .

RUN cat > /app/test-cli.sh << 'EOF'
#!/bin/bash
set -e

echo "=========================================="
echo "  Peeka CLI 测试环境"
echo "=========================================="
echo ""
echo "Python 版本: $(python --version)"
echo "peeka-cli 位置: $(which peeka-cli)"
echo ""

# 启动 demo 应用
echo "[1] 启动 demo 应用..."
python examples/demo.py --mode loop &
DEMO_PID=$!
sleep 2

echo ""
echo "Demo PID: $DEMO_PID"
echo ""
echo "=========================================="
echo "  可用的测试命令"
echo "=========================================="
echo ""
echo "# 附加到进程"
echo "peeka-cli attach $DEMO_PID"
echo ""
echo "# 观测函数调用"
echo "peeka-cli watch $DEMO_PID 'demo.Calculator.add' -n 5"
echo ""
echo "# 观测函数入口 (-b)"
echo "peeka-cli watch $DEMO_PID 'demo.Calculator.multiply' -b -n 3"
echo ""
echo "# 只观测异常 (-e)"
echo "peeka-cli watch $DEMO_PID 'demo.Calculator.divide' -e -n 5"
echo ""
echo "# 条件过滤"
echo "peeka-cli watch $DEMO_PID 'demo.Calculator.add' --condition 'params[0] > 5' -n 3"
echo ""
echo "# 追踪调用栈"
echo "peeka-cli stack $DEMO_PID 'demo.Calculator.add' -n 2"
echo ""
echo "# 性能监控"
echo "peeka-cli monitor $DEMO_PID 'demo.Calculator.add' --interval 3 -c 2"
echo ""
echo "# 搜索类和方法"
echo "peeka-cli sc $DEMO_PID 'Calculator'"
echo "peeka-cli sm $DEMO_PID 'add'"
echo ""
echo "# 查看日志级别"
echo "peeka-cli logger $DEMO_PID --action list"
echo ""
echo "# 内存分析"
echo "peeka-cli memory $DEMO_PID --action overview"
echo ""
echo "=========================================="
echo ""
echo "进入交互式 shell..."
echo ""

exec bash
EOF
RUN chmod +x /app/test-cli.sh

CMD ["/app/test-cli.sh"]

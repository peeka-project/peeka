# Peeka GDB/Python 3.12 E2E Test Image
# Test-only image for container-based E2E testing
# Do not modify docker/Dockerfile.cli, .tui, .py314, .full

FROM python:3.12-slim

LABEL maintainer="peeka"
LABEL description="Peeka E2E testing with GDB (Python 3.12)"

RUN sed -i 's|deb.debian.org|mirrors.ustc.edu.cn|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
    gdb \
    python3-dbg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY . .

RUN pip install --no-cache-dir -i https://mirrors.ustc.edu.cn/pypi/web/simple -e ".[dev]"

CMD ["sleep", "infinity"]

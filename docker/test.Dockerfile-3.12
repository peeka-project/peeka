# Peeka GDB/Python 3.12 E2E Test Image
# Test-only image for container-based E2E testing
# Used by testcontainers in tests/container/ — do not rename without updating conftest.py
#
# Usage: mount host code as volume at /app, then build _inject inside container
#   docker run -v /path/to/peeka:/app --cap-add=SYS_PTRACE peeka-test:3.12
#   cd /app && python setup.py build_ext --inplace
#
# Code is NOT baked into the image — mount via volume so the container
# reflects the latest Python source without rebuilding the image.

FROM peeka-base:3.12

LABEL maintainer="peeka"
LABEL description="Peeka E2E testing with GDB (Python 3.12)"

ENV PYTHONPATH=/app
ENV TERM=xterm-256color
ENV COLORTERM=truecolor

RUN pip install --no-cache-dir -i https://mirrors.ustc.edu.cn/pypi/web/simple \
    "textual>=7.5.0" "gevent==24.2.1"  # Gevent regression test: verify attach/watch work with monkey-patched targets

WORKDIR /app

COPY docker/restart-demo.sh /opt/restart-demo.sh

CMD ["bash", "-c", "sh /opt/restart-demo.sh; sleep infinity & wait"]

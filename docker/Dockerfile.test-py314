# Peeka Python 3.14 E2E Test Image (PEP 768)
# Test-only image for container-based E2E testing
# NOTE: 3.14-rc tag may change. Pin to specific version if reproducibility needed.
#
# Usage: mount host code as volume at /app, then pip install -e inside container
#   docker run -v /path/to/peeka:/app --cap-add=SYS_PTRACE peeka-test:py314
#
# Code is NOT baked into the image — mount via volume so the container
# always reflects the latest source without rebuilding.

FROM python:3.14-trixie

LABEL maintainer="peeka"
LABEL description="Peeka E2E testing with Python 3.14 (PEP 768)"

RUN sed -i 's|deb.debian.org|mirrors.ustc.edu.cn|g' /etc/apt/sources.list.d/debian.sources

RUN pip install --no-cache-dir -i https://mirrors.ustc.edu.cn/pypi/web/simple \
    "textual>=7.5.0"

ENV PYTHONPATH=/app
ENV TERM=xterm-256color
ENV COLORTERM=truecolor

WORKDIR /app

COPY examples/demo.py /opt/demo.py
COPY docker/restart-demo.sh /opt/restart-demo.sh

CMD ["bash", "-c", "sh /opt/restart-demo.sh; sleep infinity & wait"]

# Peeka 完整测试镜像
# 构建: docker build -f docker/Dockerfile.full -t peeka-full .
# 运行: docker run -it --cap-add=SYS_PTRACE peeka-full

FROM python:3.12-slim

LABEL maintainer="peeka"
LABEL description="Peeka full testing environment"

RUN apt-get update && apt-get install -y --no-install-recommends \
    gdb \
    procps \
    vim \
    less \
    htop \
    && rm -rf /var/lib/apt/lists/*

ENV TERM=xterm-256color

WORKDIR /app

COPY . .

RUN pip install --no-cache-dir -e ".[dev]"

RUN cat > /app/test-all.sh << 'EOF'
#!/bin/bash
set -e

echo "=========================================="
echo "  Peeka 完整测试环境"
echo "=========================================="
echo ""
echo "Python 版本: $(python --version)"
echo ""
echo "已安装组件:"
echo "  - peeka-cli: $(which peeka-cli)"
echo "  - peeka (TUI): $(which peeka)"
echo "  - pytest: $(which pytest)"
echo "  - textual: $(pip show textual | grep Version)"
echo ""

# 运行单元测试
echo "=========================================="
echo "[1] 运行单元测试"
echo "=========================================="
pytest tests/ -v --tb=short || echo "部分测试失败 (可能需要特殊权限)"
echo ""

# 启动 demo 应用
echo "=========================================="
echo "[2] 启动 demo 应用"
echo "=========================================="
python examples/demo.py --mode loop &
DEMO_PID=$!
sleep 2
echo "Demo PID: $DEMO_PID"
echo ""

echo "=========================================="
echo "  可用测试选项"
echo "=========================================="
echo ""
echo "1. CLI 测试:"
echo "   peeka-cli attach $DEMO_PID"
echo "   peeka-cli watch $DEMO_PID 'demo.Calculator.add' -n 5"
echo ""
echo "2. TUI 测试:"
echo "   peeka"
echo ""
echo "3. 运行特定测试:"
echo "   pytest tests/test_injector.py -v"
echo ""
echo "4. 兼容性测试:"
echo "   python tests/simple_compat_test.py"
echo ""
echo "=========================================="
echo ""

exec bash
EOF
RUN chmod +x /app/test-all.sh

CMD ["/app/test-all.sh"]

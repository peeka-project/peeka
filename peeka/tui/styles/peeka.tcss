/* Peeka TUI Styles — Modern Textual (Lazygit / Posting inspired) */

/* ============================================================================
   GLOBAL
   ============================================================================ */

Screen {
    background: $surface;
    scrollbar-size: 1 1;
    scrollbar-color: $surface-lighten-2;
    scrollbar-color-hover: $primary 60%;
    scrollbar-color-active: $primary;
    scrollbar-background: $surface;
}

/* ============================================================================
   PANEL SYSTEM — lazygit-style: always-visible borders, focus = bright color
   ============================================================================ */

.panel {
    border: round $primary 60%;
    border-title-color: $primary 60%;
    border-title-style: bold;
    border-title-align: left;
    padding: 0 1;
    margin: 0;
    transition: border 150ms;
}

.panel:focus-within {
    border: round $accent;
    border-title-color: $accent;
}

/* ============================================================================
   EMPTY STATE
   ============================================================================ */

.empty-state {
    content-align: center middle;
    color: $text-muted;
    text-style: italic;
    padding: 1;
}

/* ============================================================================
   PROCESS SELECTOR SCREEN
   ============================================================================ */

#process-selector {
    padding: 0 1;
}

#process-selector #title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

#process-selector #filter {
    margin-bottom: 1;
}

#process-table {
    height: 100%;
}

/* ============================================================================
   MAIN SCREEN
   ============================================================================ */

#main-container {
    padding: 0 1;
}

#pid-status {
    text-style: bold;
    color: $success;
    padding: 0 1;
}

/* ============================================================================
   TABBED CONTENT — active tab uses $primary
   ============================================================================ */

TabbedContent {
    height: 1fr;
}

Tabs {
    dock: top;
    background: $surface;
    color: $text-muted;
}

Tab {
    padding: 0 2;
    color: $text-muted;
    background: $surface;
}

Tab:hover {
    color: $text;
    background: $surface-lighten-1;
}

Tab.-active {
    color: $text;
    background: $primary;
    text-style: bold;
}

TabPane {
    padding: 0;
}

/* ============================================================================
   VIEW CONTAINERS — outer border with panel styling
   ============================================================================ */

#dashboard-container,
#watch-container,
#trace-container,
#stack-container,
#monitor-container,
#memory-container,
#logger-container,
#inspect-container {
    padding: 0 1;
    border: round $primary 60%;
    border-title-color: $primary 60%;
    border-title-style: bold;
    border-title-align: left;
}

#dashboard-container:focus-within,
#watch-container:focus-within,
#trace-container:focus-within,
#stack-container:focus-within,
#monitor-container:focus-within,
#memory-container:focus-within,
#logger-container:focus-within,
#inspect-container:focus-within {
    border: round $accent;
    border-title-color: $accent;
}

/* ============================================================================
   DASHBOARD VIEW
   ============================================================================ */

#metrics-row, #activity-row {
    height: auto;
    margin-bottom: 1;
}

.dashboard-card {
    border: round $primary 60%;
    border-title-color: $primary 60%;
    border-title-style: bold;
    border-title-align: left;
    padding: 0 1;
    margin: 0 1 0 0;
    min-width: 30;
    transition: border 150ms;
}

.dashboard-card:focus-within {
    border: round $accent;
    border-title-color: $accent;
}

#pid-info, #python-version, #uptime,
#mem-rss, #mem-traced, #mem-peak,
#watch-count,
#gc-gen0, #gc-gen1, #gc-gen2 {
    margin: 1 0;
}

/* ============================================================================
   CONTROLS — shared pattern across Watch, Trace, Stack, Monitor, Logger, Inspect
   ============================================================================ */

#watch-controls,
#trace-controls,
#stack-controls,
#monitor-controls,
#logger-controls,
#inspect-controls {
    height: auto;
    margin-bottom: 1;
}

#watch-controls Input,
#watch-controls AutoCompleteInput,
#trace-controls Input,
#trace-controls AutoCompleteInput,
#stack-controls Input,
#monitor-controls Input,
#logger-controls Input,
#inspect-controls Input {
    width: 1fr;
    margin-right: 1;
}

#watch-controls Button,
#trace-controls Button,
#stack-controls Button,
#monitor-controls Button,
#logger-controls Button,
#inspect-controls Button {
    margin-left: 1;
    min-width: 8;
    max-width: 14;
}

/* ============================================================================
   SPLIT-PANE CONTENT AREAS
   ============================================================================ */

#watch-content,
#trace-content,
#stack-content,
#memory-content,
#inspect-content {
    height: 1fr;
}

/* ============================================================================
   WATCH VIEW — panel-specific sizing
   ============================================================================ */

#watch-list {
    width: 40%;
    margin-right: 1;
}

#observations-panel {
    width: 60%;
}

#watch-table {
    height: 100%;
}

#observations-log {
    height: 100%;
}

/* ============================================================================
   TRACE VIEW — panel-specific sizing
   ============================================================================ */

#trace-list {
    width: 35%;
    margin-right: 1;
}

#trace-tree-panel {
    width: 65%;
}

#trace-table {
    height: 100%;
}

#call-tree {
    height: 1fr;
    margin-bottom: 1;
}

#trace-stats {
    height: auto;
    padding: 0 1;
    border: round $primary 60%;
    border-title-color: $primary 60%;
}

/* ============================================================================
   STACK VIEW — panel-specific sizing
   ============================================================================ */

#stack-panel {
    width: 60%;
}

#stack-tree {
    height: 100%;
}

/* ============================================================================
   MONITOR VIEW — panel-specific sizing
   ============================================================================ */

#stats-panel {
    height: 1fr;
}

#stats-table {
    height: 100%;
}

/* ============================================================================
   MEMORY VIEW — panel-specific sizing
   ============================================================================ */

#memory-controls {
    height: auto;
    margin-bottom: 1;
}

#memory-controls Button {
    margin-right: 1;
}

#mem-overview {
    width: 40%;
    margin-right: 1;
}

#mem-objects {
    width: 60%;
}

#mem-total, #mem-rss, #mem-vms {
    margin: 1 0;
}

#mem-objects-table {
    height: 100%;
}

/* ============================================================================
   LOGGER VIEW — panel-specific sizing
   ============================================================================ */

#logger-list {
    height: 1fr;
    margin-bottom: 1;
}

#logger-table {
    height: 100%;
}

#logger-set-controls {
    height: auto;
}

#logger-set-controls Input {
    width: 1fr;
    margin-right: 1;
}

#logger-set-controls Button {
    margin-left: 1;
}

/* ============================================================================
   INSPECT VIEW — panel-specific sizing
   ============================================================================ */

#inspect-tree-panel {
    width: 40%;
    margin-right: 1;
}

#inspect-details-panel {
    width: 60%;
}

#inspect-tree {
    height: 100%;
}

#inspect-details {
    height: 100%;
}

/* ============================================================================
   INPUT WIDGETS — visible borders with focus transition
   ============================================================================ */

Input {
    border: round $surface-lighten-2;
    transition: border 150ms;
}

Input:focus {
    border: round $primary;
}

/* ============================================================================
   INPUT LABELS
   ============================================================================ */

.input-label {
    width: auto;
    padding: 0 1;
    content-align: center middle;
    height: 3;
    color: $text-muted;
}

/* ============================================================================
   AUTOCOMPLETE WIDGET
   ============================================================================ */

AutoCompleteInput {
    width: 1fr;
    height: auto;
}

AutoCompleteInput #ac-input {
    width: 100%;
}

AutoCompleteInput #ac-dropdown {
    max-height: 10;
    border: round $accent;
    background: $surface;
    padding: 0 1;
}

/* ============================================================================
   HELP SCREEN
   ============================================================================ */

#help-container {
    width: 80%;
    height: 80%;
    border: round $accent;
    border-title-color: $text;
    border-title-style: bold;
    border-title-align: center;
    background: $surface;
    padding: 1;
}

#help-content {
    height: 100%;
    overflow-y: auto;
}

/* ============================================================================
   BUTTONS — compact, consistent
   ============================================================================ */

Button {
    min-width: 8;
    max-width: 14;
}

Button.success {
    background: $success;
}

Button.error {
    background: $error;
}

Button.warning {
    background: $warning;
}

/* ============================================================================
   DATA TABLE — zebra striping, primary header, bold cursor
   ============================================================================ */

DataTable {
    background: $surface;
}

DataTable > .datatable--header {
    background: $primary 20%;
    text-style: bold;
    color: $text;
}

DataTable > .datatable--cursor {
    background: $primary;
    color: $text;
    text-style: bold;
}

DataTable > .datatable--even-row {
    background: $surface-lighten-1 30%;
}

/* Peeka TUI Styles - Lazygit/Lazydocker Inspired */

/* ============================================================================
   GLOBAL STYLES
   ============================================================================ */

Screen {
    background: $surface;
}

/* ============================================================================
   PANEL SYSTEM - Lazygit-style bordered panels
   ============================================================================ */

.panel {
    border: solid $surface-lighten-2;
    border-title-color: $text;
    border-title-style: bold;
    border-title-align: left;
    padding: 1 2;
    margin: 1 0;
}

.panel:focus-within {
    border: solid $accent;
}

/* ============================================================================
   EMPTY STATE - Placeholder text for empty views
   ============================================================================ */

.empty-state {
    content-align: center middle;
    color: $text-muted;
    text-style: italic;
    padding: 2;
}

/* ============================================================================
   PROCESS SELECTOR SCREEN
   ============================================================================ */

#process-selector {
    padding: 1 2;
}

#process-selector #title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

#process-selector #filter {
    margin-bottom: 1;
}

#process-table {
    height: 100%;
}

/* ============================================================================
   MAIN SCREEN
   ============================================================================ */

#main-container {
    padding: 0 1;
}

#pid-status {
    text-style: bold;
    color: $success;
    padding: 0 1;
}

/* ============================================================================
   DASHBOARD VIEW
   ============================================================================ */

#dashboard-container {
    padding: 1 2;
}

#metrics-row, #activity-row {
    height: auto;
    margin-bottom: 1;
}

.dashboard-card {
    border: solid $surface-lighten-2;
    border-title-color: $text;
    border-title-style: bold;
    border-title-align: left;
    padding: 1 2;
    margin: 0 1 0 0;
    min-width: 30;
}

.dashboard-card:focus-within {
    border: solid $accent;
}

#process-info, #memory-section, #watch-section, #gc-section {
    border-title-color: $text;
}

#pid-info, #python-version, #uptime,
#mem-rss, #mem-traced, #mem-peak,
#watch-count,
#gc-gen0, #gc-gen1, #gc-gen2 {
    margin: 1 0;
}

/* ============================================================================
   WATCH VIEW
   ============================================================================ */

#watch-container {
    padding: 1 2;
}

#watch-controls {
    height: auto;
    margin-bottom: 1;
}

#watch-controls Input,
#watch-controls AutoCompleteInput {
    width: 1fr;
    margin-right: 1;
}

#watch-controls Button {
    margin-left: 1;
    min-width: 8;
    max-width: 12;
}

#watch-content {
    height: 1fr;
}

#watch-list {
    width: 40%;
    margin-right: 1;
    border: solid $surface-lighten-2;
    border-title-color: $text;
    border-title-style: bold;
    border-title-align: left;
    padding: 1 2;
}

#watch-list:focus-within {
    border: solid $accent;
}

#observations-panel {
    width: 60%;
    border: solid $surface-lighten-2;
    border-title-color: $text;
    border-title-style: bold;
    border-title-align: left;
    padding: 1 2;
}

#observations-panel:focus-within {
    border: solid $accent;
}

#watch-table {
    height: 100%;
}

#observations-log {
    height: 100%;
}

/* ============================================================================
   STACK VIEW
   ============================================================================ */

#stack-container {
    padding: 1 2;
}

#stack-controls {
    height: auto;
    margin-bottom: 1;
}

#stack-controls Input {
    width: 1fr;
    margin-right: 1;
}

#stack-controls Button {
    margin-left: 1;
    min-width: 8;
    max-width: 12;
}

#stack-content {
    height: 1fr;
}

#trace-list {
    width: 40%;
    margin-right: 1;
    border: solid $surface-lighten-2;
    border-title-color: $text;
    border-title-style: bold;
    border-title-align: left;
    padding: 1 2;
}

#trace-list:focus-within {
    border: solid $accent;
}

#stack-panel {
    width: 60%;
    border: solid $surface-lighten-2;
    border-title-color: $text;
    border-title-style: bold;
    border-title-align: left;
    padding: 1 2;
}

#stack-panel:focus-within {
    border: solid $accent;
}

#trace-table {
    height: 100%;
}

#stack-tree {
    height: 100%;
}

/* ============================================================================
   MONITOR VIEW
   ============================================================================ */

#monitor-container {
    padding: 1 2;
}

#monitor-controls {
    height: auto;
    margin-bottom: 1;
}

#monitor-controls Input {
    width: 1fr;
    margin-right: 1;
}

#monitor-controls Button {
    margin-left: 1;
    min-width: 10;
    max-width: 14;
}

#stats-panel {
    height: 1fr;
    border: solid $surface-lighten-2;
    border-title-color: $text;
    border-title-style: bold;
    border-title-align: left;
    padding: 1 2;
}

#stats-panel:focus-within {
    border: solid $accent;
}

#stats-table {
    height: 100%;
}

/* ============================================================================
   MEMORY VIEW
   ============================================================================ */

#memory-container {
    padding: 1 2;
}

#memory-controls {
    height: auto;
    margin-bottom: 1;
}

#memory-controls Button {
    margin-right: 1;
}

#memory-content {
    height: 1fr;
}

#mem-overview {
    width: 40%;
    margin-right: 1;
    border: solid $surface-lighten-2;
    border-title-color: $text;
    border-title-style: bold;
    border-title-align: left;
    padding: 1 2;
}

#mem-overview:focus-within {
    border: solid $accent;
}

#mem-objects {
    width: 60%;
    border: solid $surface-lighten-2;
    border-title-color: $text;
    border-title-style: bold;
    border-title-align: left;
    padding: 1 2;
}

#mem-objects:focus-within {
    border: solid $accent;
}

#mem-total, #mem-rss, #mem-vms {
    margin: 1 0;
}

#mem-objects-table {
    height: 100%;
}

/* ============================================================================
   LOGGER VIEW
   ============================================================================ */

#logger-container {
    padding: 1 2;
}

#logger-controls {
    height: auto;
    margin-bottom: 1;
}

#logger-controls Input {
    width: 1fr;
    margin-right: 1;
}

#logger-controls Button {
    margin-left: 1;
}

#logger-list {
    height: 1fr;
    margin-bottom: 1;
    border: solid $surface-lighten-2;
    border-title-color: $text;
    border-title-style: bold;
    border-title-align: left;
    padding: 1 2;
}

#logger-list:focus-within {
    border: solid $accent;
}

#logger-table {
    height: 100%;
}

#logger-set-controls {
    height: auto;
}

#logger-set-controls Input {
    width: 1fr;
    margin-right: 1;
}

#logger-set-controls Button {
    margin-left: 1;
}

/* ============================================================================
   INSPECT VIEW
   ============================================================================ */

#inspect-container {
    padding: 1 2;
}

#inspect-controls {
    height: auto;
    margin-bottom: 1;
}

#inspect-controls Input {
    width: 1fr;
    margin-right: 1;
}

#inspect-controls Button {
    margin-left: 1;
}

#inspect-content {
    height: 1fr;
}

#inspect-tree-panel {
    width: 40%;
    margin-right: 1;
    border: solid $surface-lighten-2;
    border-title-color: $text;
    border-title-style: bold;
    border-title-align: left;
    padding: 1 2;
}

#inspect-tree-panel:focus-within {
    border: solid $accent;
}

#inspect-details-panel {
    width: 60%;
    border: solid $surface-lighten-2;
    border-title-color: $text;
    border-title-style: bold;
    border-title-align: left;
    padding: 1 2;
}

#inspect-details-panel:focus-within {
    border: solid $accent;
}

#inspect-tree {
    height: 100%;
}

#inspect-details {
    height: 100%;
}

/* ============================================================================
   INPUT LABELS
   ============================================================================ */

.input-label {
    width: auto;
    padding: 0 1;
    content-align: center middle;
    height: 3;
    color: $text-muted;
}

/* ============================================================================
   AUTOCOMPLETE WIDGET
   ============================================================================ */

AutoCompleteInput {
    width: 1fr;
    height: auto;
}

AutoCompleteInput #ac-input {
    width: 100%;
}

AutoCompleteInput #ac-dropdown {
    max-height: 10;
    border: solid $accent;
    background: $surface;
    padding: 1;
}

/* ============================================================================
   HELP SCREEN
   ============================================================================ */

#help-container {
    width: 80%;
    height: 80%;
    border: solid $accent;
    border-title-color: $text;
    border-title-style: bold;
    border-title-align: center;
    background: $surface;
    padding: 2;
}

#help-content {
    height: 100%;
    overflow-y: auto;
}

/* ============================================================================
   BUTTON STYLING - Consistent compact buttons
   ============================================================================ */

Button {
    min-width: 8;
    max-width: 14;
}

Button.success {
    background: $success;
}

Button.error {
    background: $error;
}

Button.warning {
    background: $warning;
}

/* ============================================================================
   DATA TABLE STYLING - Clean rows with subtle styling
   ============================================================================ */

DataTable {
    background: $surface;
}

DataTable > .datatable--header {
    background: $surface-lighten-1;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $accent;
}

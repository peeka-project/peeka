/* Peeka TUI Styles — Layout only (theme handles colors/borders) */

/* ============================================================================
   GLOBAL
   ============================================================================ */

Screen {
    scrollbar-size: 1 1;
}

/* ============================================================================
   PANEL SYSTEM
   ============================================================================ */

.panel {
    padding: 0 1;
    margin: 0;
}

/* ============================================================================
   EMPTY STATE
   ============================================================================ */

.empty-state {
    content-align: center middle;
    padding: 1;
}

/* ============================================================================
   PROCESS SELECTOR SCREEN
   ============================================================================ */

#process-selector {
    padding: 0 1;
}

#process-selector #title {
    margin-bottom: 1;
}

#process-selector #filter {
    margin-bottom: 1;
}

#process-table {
    height: 100%;
}

/* ============================================================================
   MAIN SCREEN
   ============================================================================ */

#main-container {
    padding: 0 1;
}

#pid-status {
    padding: 0 1;
}

/* ============================================================================
   TABBED CONTENT
   ============================================================================ */

TabbedContent {
    height: 1fr;
}

Tabs {
    dock: top;
}

Tab {
    padding: 0 2;
}

TabPane {
    padding: 0;
}

/* ============================================================================
   VIEW CONTAINERS
   ============================================================================ */

#dashboard-container,
#watch-container,
#trace-container,
#stack-container,
#monitor-container,
#logger-container,
#inspect-container,
#thread-container,
#top-container {
    padding: 0 1;
}

/* ============================================================================
   THREAD VIEW
   ============================================================================ */

#thread-header {
    height: auto;
    margin-bottom: 1;
}

#thread-summary {
    padding: 0 1;
}

#thread-content {
    height: 1fr;
}

#threads-list {
    width: 50%;
    margin-right: 1;
}

#thread-stack-panel {
    width: 50%;
}

#threads-table {
    height: 100%;
}

#thread-stack-tree {
    height: 100%;
}

/* ============================================================================
   DASHBOARD VIEW
   ============================================================================ */

#dash-thread-summary {
    height: auto;
    padding: 0 1;
    margin-bottom: 0;
}

#dash-thread-section {
    height: 1fr;
    min-height: 10;
}

#dash-thread-table {
    height: 1fr;
}

#dash-mid-row {
    height: auto;
    max-height: 10;
    margin-bottom: 0;
}

#dash-memory-section {
    width: 1fr;
    margin-right: 1;
}

#dash-gc-section {
    width: 1fr;
}

#dash-mem-table,
#dash-gc-table {
    height: auto;
    max-height: 8;
}

#dash-runtime-section {
    height: auto;
    max-height: 12;
}

#dash-runtime-info {
    padding: 0 1;
}
/* ============================================================================
   CONTROLS — shared pattern across views
   ============================================================================ */

#watch-controls,
#trace-controls,
#stack-controls,
#monitor-controls,
#logger-controls,
#inspect-controls,
#top-controls {
    height: auto;
    margin-bottom: 1;
}

#watch-controls Input,
#watch-controls AutoCompleteInput,
#trace-controls Input,
#trace-controls AutoCompleteInput,
#stack-controls Input,
#stack-controls AutoCompleteInput,
#monitor-controls Input,
#monitor-controls AutoCompleteInput,
#logger-controls Input,
#inspect-controls Input {
    width: 1fr;
    margin-right: 1;
}

#watch-controls Button,
#trace-controls Button,
#stack-controls Button,
#monitor-controls Button,
#logger-controls Button,
#inspect-controls Button,
#top-controls Button {
    margin-left: 1;
    min-width: 8;
    max-width: 14;
}

/* ============================================================================
   SPLIT-PANE CONTENT AREAS
   ============================================================================ */

#watch-content,
#trace-content,
#stack-content,
#memory-content,
#inspect-content {
    height: 1fr;
}

/* ============================================================================
   WATCH VIEW
   ============================================================================ */

#watch-list {
    width: 40%;
    margin-right: 1;
}

#observations-panel {
    width: 60%;
}

#watch-table {
    height: 100%;
}

#observations-table {
    height: 2fr;
}

#observation-detail {
    height: 1fr;
}

/* ============================================================================
   TRACE VIEW
   ============================================================================ */

#trace-list {
    width: 35%;
    margin-right: 1;
}

#trace-tree-panel {
    width: 65%;
}

#trace-table {
    height: auto;
    max-height: 8;
}

#trace-obs-table {
    height: 1fr;
}

#call-tree {
    height: 1fr;
    margin-bottom: 1;
}

#trace-stats {
    height: auto;
    padding: 0 1;
}
/* ============================================================================
   STACK VIEW
   ============================================================================ */

#stack-list {
    width: 40%;
    margin-right: 1;
}

#stack-table {
    height: 100%;
}

#stack-panel {
    width: 60%;
}

#stack-tree {
    height: 100%;
}

/* ============================================================================
   MONITOR VIEW
   ============================================================================ */

#stats-panel {
    height: 1fr;
}

#stats-table {
    height: 100%;
}

/* ============================================================================
   MEMORY VIEW
   ============================================================================ */

#memory-container {
    height: auto;
    padding: 0 1;
}

#memory-status-bar {
    width: 1fr;
    height: auto;
    margin-bottom: 1;
}

#memory-status-bar Static {
    width: auto;
    height: 3;
    content-align: center middle;
    padding: 0 1;
}

#memory-status-bar Button {
    margin-left: 1;
    min-width: 8;
    max-width: 10;
}

#memory-status-bar Input {
    width: 8;
    margin-right: 1;
}

#memory-status-bar #mem-nframe-input {
    width: 12;
    margin-right: 1;
}

#mem-gc-limit-input, #mem-alloc-limit-input {
    width: 10;
    margin-right: 1;
}

.separator {
    width: 1;
    height: 3;
    content-align: center middle;
    color: $text-muted;
    margin: 0 1;
}

.spacer {
    width: 1fr;
}

#memory-status-bar .spacer {
    width: 1fr;
    padding: 0;
}

#mem-gc-controls,
#mem-alloc-controls {
    height: auto;
    margin-bottom: 1;
}

#mem-gc-controls Button,
#mem-alloc-controls Button {
    margin-left: 1;
    min-width: 8;
    max-width: 14;
}


#mem-objects-table {
    height: 100%;
}

#mem-tabs {
    height: 1fr;
}

#mem-tabs ContentSwitcher {
    height: 1fr;
}

#mem-tabs TabPane {
    height: 1fr;
}

#mem-allocations-content {
    height: 1fr;
}

#mem-alloc-table {
    height: 1fr;
}

#mem-alloc-placeholder {
    content-align: center middle;
    color: $text-muted;
    text-style: italic;
}

/* Placeholder styling */
#mem-alloc-placeholder, #mem-diff-placeholder, #mem-references-placeholder {
    content-align: center middle;
    color: $text-muted;
    text-style: italic;
}

#mem-references-controls {
    height: auto;
}

#mem-references-controls Input {
    width: 1fr;
    margin-right: 1;
}

#mem-references-controls Button {
    margin-left: 1;
}
/* ============================================================================
   LOGGER VIEW
   ============================================================================ */

#logger-list {
    height: 1fr;
    margin-bottom: 1;
}

#logger-table {
    height: 100%;
}

#logger-set-controls {
    height: auto;
}

#logger-set-controls Input {
    width: 1fr;
    margin-right: 1;
}

#logger-set-controls Button {
    margin-left: 1;
}

/* ============================================================================
   INSPECT VIEW
   ============================================================================ */

#inspect-tree-panel {
    width: 40%;
    margin-right: 1;
}

#inspect-details-panel {
    width: 60%;
}

#inspect-tree {
    height: 100%;
}

#inspect-details {
    height: 100%;
}

/* ============================================================================
   INPUT LABELS
   ============================================================================ */

.input-label {
    width: auto;
    padding: 0 1;
    content-align: center middle;
    height: 3;
}

/* ============================================================================
   AUTOCOMPLETE WIDGET
   ============================================================================ */

AutoCompleteInput {
    width: 1fr;
    height: auto;
}

AutoCompleteInput #ac-input {
    width: 100%;
}

AutoCompleteInput #ac-dropdown {
    max-height: 10;
    padding: 0 1;
}

/* ============================================================================
   HELP SCREEN
   ============================================================================ */

#help-container {
    width: 80%;
    height: 80%;
    padding: 1;
}

#help-content {
    height: 100%;
    overflow-y: auto;
}

/* ============================================================================
   BUTTONS
   ============================================================================ */

Button {
    min-width: 8;
    max-width: 14;
}


/* ============================================================================
   TOP VIEW
   ============================================================================ */

#top-header {
    height: 1;
}

#top-table {
    height: 1fr;
}

#top-footer {
    height: 1;
}